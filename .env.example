# Copy to .env for local overrides. Never commit .env.
# Docker Compose substitutes these when .env exists beside docker-compose.yml.
# The API also reads the same names from the process environment.

ELEXON_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1
STUDY_START=2026-01-01
STUDY_END=2026-01-31
FUEL_TYPE=WIND
DECISION_TIMEZONE=Europe/London
DECISION_CUTOFF_LOCAL=09:00
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
LOG_LEVEL=INFO

# Origin of the API for the browser. Leave empty to call /api on the page origin
# (the Vite dev proxy or the nginx container). Example: http://localhost:8000
VITE_API_BASE_URL=

# Latest successful FUELHH and WINDFOR extract. A relative path is resolved from
# the backend directory. The data directory is gitignored except for the public
# January 2026 snapshot shipped with the deployment.
CACHE_PATH=data/wind_procurement.sqlite
HTTP_CONNECT_TIMEOUT_SECONDS=5
HTTP_READ_TIMEOUT_SECONDS=120
HTTP_MAX_ATTEMPTS=3
HTTP_RETRY_BACKOFF_SECONDS=1
FORECAST_PUBLISH_LOOKBACK_DAYS=3
FORECAST_PUBLISH_LOOKAHEAD_DAYS=3
